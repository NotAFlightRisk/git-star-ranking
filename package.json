{
  "name": "git-star-ranking",
  "version": "0.1.0",
  "description": "GitHub star ranking for users, organizations and repositories",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/git-star-ranking.git"
  },
  "homepage": "https://git-star-ranking.com",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite build && wrangler dev src/worker.ts --test-scheduled",
    "build": "vite build && wrangler deploy src/worker.ts --dry-run --outdir .wrangler/dist",
    "deploy": "vite build && wrangler deploy src/worker.ts",
    "migrate": "wrangler d1 migrations apply DB",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sentry/browser": "^11.11.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "simple-icons": "^16.37.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
